# ============================================================================
# .env.example — pdfbot
#
# Copy this file to `.env` and edit the copy:
#     cp .env.example .env
#
# Rules:
#   * `.env` is git-ignored, `.env.example` is tracked. Never put a real
#     secret in this file — only placeholders or safe defaults.
#   * Every key below is read by `pdfbot.config.Settings` (pydantic-settings).
#   * An uncommented `KEY=value` line is a working default. Override it in
#     your `.env` to change behaviour. Leave it as-is to keep the default.
#   * An uncommented `KEY=` with an empty value means "optional": the app
#     falls back to auto-detection, the platform default, or disables the
#     feature. Fill it in to enable.
#   * A commented `# KEY=value` line is an advanced setting. Uncomment it
#     only if you need it — the default is already safe.
#   * Values are validated by pydantic on startup. A wrong type fails fast
#     with a clear error instead of misbehaving silently.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. Paths
# ----------------------------------------------------------------------------

# Where the app writes its outputs (packs/, RawTranslatedMaterial/, history.db).
# Type: path | Default: platform-specific (see README §Configuration)
# Leave empty to use the OS-appropriate directory chosen by `platformdirs`:
#   Linux:   ~/.local/share/pdfbot
#   macOS:   ~/Library/Application Support/pdfbot
#   Windows: %APPDATA%\pdfbot
DATA_DIR=

# Where log files are written.
# Type: path | Default: <DATA_DIR>/logs
LOG_DIR=


# ----------------------------------------------------------------------------
# 2. PDF splitting
# ----------------------------------------------------------------------------

# Default pages-per-pack pre-filled in the CLI and GUI when not supplied.
# Type: int (1–10000) | Default: 25
PACK_SIZE=25


# ----------------------------------------------------------------------------
# 3. Browser & translation
# ----------------------------------------------------------------------------

# Absolute path to the Brave executable.
# Type: path | Default: auto-detected from common install locations
# Set this only if auto-detection fails.
BRAVE_PATH=

# Where Playwright keeps the persistent Brave profile (cookies, local storage).
# Type: path | Default: <DATA_DIR>/browser_profile
# Reusing the same profile across runs keeps Google's session warm and
# reduces captcha frequency.
BROWSER_PROFILE_DIR=

# Show the browser window during translation.
# Type: bool | Default: false | Allowed: true, false
# Set to `true` when debugging Google Translate selectors; leave `false`
# for normal use.
HEADLESS=false

# Playwright per-action timeout, in seconds.
# Type: int | Default: 30
# BROWSER_TIMEOUT=30

# Which translator backend the pipeline uses.
# Type: enum | Default: browser | Allowed: browser, deep, cloud
#   browser → Playwright + Brave against translate.google.com (default)
#   deep    → deep-translator, no browser, unofficial endpoint
#   cloud   → Google Cloud Translation v3, requires GOOGLE_API_KEY
TRANSLATOR_BACKEND=browser

# Default source and target languages (ISO-639-1 codes).
# Type: str | Defaults: en, fr
DEFAULT_SRC_LANG=en
DEFAULT_TGT_LANG=fr

# Delay between consecutive Google Translate requests, in seconds.
# Type: float | Default: 5.0
# Higher values reduce captcha risk at the cost of throughput.
TRANSLATE_DELAY_SECONDS=5.0

# Maximum characters sent to Google in a single translate request.
# Type: int | Default: 4500
# Long packs are chunked on paragraph boundaries and reassembled after.
TRANSLATE_CHUNK_CHARS=4500


# ----------------------------------------------------------------------------
# 4. Databases
# ----------------------------------------------------------------------------

# SQLAlchemy URL for the local SQLite database.
# Type: str | Default: sqlite:///<DATA_DIR>/history.db
# Leave empty to derive it from DATA_DIR. Change only for tests or a
# custom data layout.
SQLITE_URL=

# SQLAlchemy URL for the remote PostgreSQL database (the mirror).
# Type: str | Default: (unset) → PostgreSQL mirror disabled
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Leave empty to run purely local. Tasks still write to SQLite; the sync
# worker is simply disabled.
POSTGRES_DSN=


# ----------------------------------------------------------------------------
# 5. Sync worker (SQLite → PostgreSQL)
# ----------------------------------------------------------------------------

# How often the sync thread wakes up to push unsynced rows to PostgreSQL.
# Type: int (seconds) | Default: 60
SYNC_INTERVAL_SECONDS=60

# Maximum retry backoff for PostgreSQL sync, in seconds.
# Type: int | Default: 300
# SYNC_MAX_BACKOFF_SECONDS=300


# ----------------------------------------------------------------------------
# 6. Logging
# ----------------------------------------------------------------------------

# Log verbosity.
# Type: enum | Default: INFO | Allowed: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Rotate the log file after this many bytes.
# Type: int | Default: 10485760 (10 MiB)
# LOG_ROTATE_BYTES=10485760

# Keep this many rotated log files.
# Type: int | Default: 5
# LOG_BACKUP_COUNT=5


# ----------------------------------------------------------------------------
# 7. Operator / audit
# ----------------------------------------------------------------------------

# Value written to `task.done_by` in both SQLite and PostgreSQL.
# Type: str | Default: current OS username
# Set this when the app runs under a shared service account so the audit
# trail records the real operator instead of `svc-pdfbot`.
OPERATOR_NAME=


# ----------------------------------------------------------------------------
# 8. Google Cloud Translation (only if TRANSLATOR_BACKEND=cloud)
# ----------------------------------------------------------------------------

# API key for Google Cloud Translation v3.
# Type: str | Default: (unset)
# GOOGLE_API_KEY=

# Google Cloud project ID (required by Translation v3).
# Type: str | Default: (unset)
# GOOGLE_CLOUD_PROJECT=